# Mẫu cấu hình cho scripts/oracle-arm-retry.sh. Sao chép ra ngoài repo (vd. ~/oracle-arm.env), điền giá trị thật, KHÔNG commit.
# Tất cả OCID lấy trong Oracle Cloud Console (Compartment, VCN > Subnet, Compute > Images).
COMPARTMENT_OCID=ocid1.compartment.oc1..xxxx
SUBNET_OCID=ocid1.subnet.oc1.<region>.xxxx
# Ảnh phải là bản ARM (aarch64), ví dụ Canonical Ubuntu 22.04 / 24.04 "aarch64".
IMAGE_OCID=ocid1.image.oc1.<region>.xxxx
SSH_PUBLIC_KEY_FILE=$HOME/.ssh/id_rsa.pub

# Tùy chọn (giá trị mặc định ghi sẵn)
# AVAILABILITY_DOMAINS=XXXX:AP-SINGAPORE-1-AD-1
# OCPUS=2
# MEMORY_GB=12
# BOOT_VOLUME_GB=50
# DISPLAY_NAME=discord-bot-arm
# SLEEP_SECONDS=60
# RATE_LIMIT_SLEEP_SECONDS=300
# MAX_ATTEMPTS=0
