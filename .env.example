# Sao chép thành .env. Không commit token, API key hoặc khóa bí mật.
# Triển khai: npm run register rồi npm start.
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Tùy chọn: admin của bot ngoài người có quyền Administrator trong server.
# ADMIN_USER_ID=

# Khóa tích hợp chỉ đặt ở máy chủ, tuyệt đối không cấu hình qua Discord.
# OPENAI_API_KEY=
# TOWER_GENERATOR_SECRET=
# Endpoint AI tùy chỉnh là cấu hình tin cậy của máy chủ, không sửa qua Discord.
# OPENAI_BASE_URL=

# Tùy chọn triển khai. Bỏ trống để dùng mặc định.
# DB_PATH=./data/game-bot.sqlite
# LOG_LEVEL=info
# ENABLE_MESSAGE_COMMANDS=false
# COMMAND_PREFIX=!

# Cấu hình trong Discord (chỉ admin):
# /quantri cauhinh: xu khởi đầu, EXP/cấp và drop xu chung.
# /<game> cauhinh: kênh, bảo trì, cược, hệ số và biến riêng của game.
# /vtv cauhinh, /sinhton cauhinh, /chatbot cauhinh, /gacha cauhinh.
# Chatbot: chọn nhà cung cấp/model, token tối đa, lượt/ngày và Search trong menu.
# Giữ tương thích .env cũ làm mặc định; cấu hình đã lưu theo server được ưu tiên.
