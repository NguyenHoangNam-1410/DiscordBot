# ============================================================================
# Cấu hình môi trường của bot. Sao chép file này thành `.env` rồi điền giá trị.
# - Dòng bắt đầu bằng `#` là tùy chọn: bỏ dấu `#` để bật, giữ nguyên để dùng mặc định.
# - KHÔNG commit file `.env` (đã nằm trong .gitignore). Không dán token/khóa vào chat.
# - Sau khi đổi giá trị, khởi động lại bot. Lệnh slash mới cần `npm run register`.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Discord (bắt buộc)
# ----------------------------------------------------------------------------
# Token của bot (Developer Portal > Bot > Reset Token).
DISCORD_TOKEN=
# Application ID của bot và ID server dùng khi đăng ký lệnh (`npm run register`).
CLIENT_ID=
GUILD_ID=
# ID người dùng Discord có quyền admin của bot; nhiều người cách nhau bằng dấu phẩy.
# Người có quyền Administrator trong server cũng dùng được lệnh admin.
ADMIN_USER_ID=

# Bật lệnh dùng dấu tiền tố (ví dụ !hoi, !chatbot, !vtv): 1/true/yes để bật. Mặc định tắt.
# Cần bật Message Content Intent trong Developer Portal. (ENABLE_PREFIX_COMMANDS là tên cũ.)
ENABLE_MESSAGE_COMMANDS=false
# ENABLE_PREFIX_COMMANDS=false
# Dấu tiền tố của lệnh. Mặc định `!`.
# COMMAND_PREFIX=!
# Kênh gửi thông báo khi chạy `scripts/post-announcement.js`.
# ANNOUNCE_CHANNEL_ID=

# ----------------------------------------------------------------------------
# 2. Chatbot AI (/chatbot, !hoi) — tùy chọn, chỉ bật khi có OPENAI_API_KEY
# ----------------------------------------------------------------------------
# Khóa API của nhà cung cấp đang dùng (tên biến vẫn là OPENAI_API_KEY dù là Gemini/OpenRouter).
# OPENAI_API_KEY=
# Nhà cung cấp: openai (mặc định) | gemini | openrouter.
# CHATBOT_PROVIDER=openai
# Model. Có thể là danh sách phân tách bằng dấu phẩy: model đầu là chính, các model sau là dự phòng
# khi bị giới hạn lượt (429) hoặc lỗi máy chủ. Mặc định: openai=gpt-4o-mini, gemini=gemini-3.8-flash.
# OpenRouter bắt buộc phải đặt (chọn model có đuôi `:free` ở openrouter.ai/models).
# OPENAI_MODEL=gpt-4o-mini
# Địa chỉ API tương thích OpenAI khác (ghi đè địa chỉ của CHATBOT_PROVIDER; tắt kiểm duyệt OpenAI).
# OPENAI_BASE_URL=
# Số lượt chat mỗi người mỗi ngày (giờ Việt Nam). Mặc định 20; admin chỉnh theo server bằng /chatbot gioihan.
# CHATBOT_DAILY_LIMIT=20
# Số token tối đa của mỗi câu trả lời (100–8000). Mặc định 1500; model "suy nghĩ" cần đủ chỗ.
# CHATBOT_MAX_TOKENS=1500
# Chờ (mili giây) trước khi thử lại một vòng khi mọi model đều bị giới hạn. Mặc định 2000.
# CHATBOT_RETRY_DELAY_MS=2000
# Bật Google Search (grounding) cho chatbot: 1 = bật. Chỉ dùng với CHATBOT_PROVIDER=gemini (Gemini 3 trở lên),
# không dùng cùng OPENAI_BASE_URL. Câu trả lời kèm tối đa 3 link nguồn. Google tính phí theo lượt tìm kiếm
# sau hạn mức miễn phí hằng tháng.
# CHATBOT_GOOGLE_SEARCH=0

# ----------------------------------------------------------------------------
# 3. Dữ liệu, log và múi giờ
# ----------------------------------------------------------------------------
# Đường dẫn file SQLite. Mặc định ./data/game-bot.sqlite
# DB_PATH=./data/game-bot.sqlite
# Thư mục và tên file log; mức log (trace|debug|info|warn|error).
# LOG_DIR=./logs
# LOG_FILE_NAME=bot.log
# LOG_LEVEL=info
# Múi giờ tính nhiệm vụ/điểm danh. Mặc định Asia/Bangkok (đua ngựa dùng Asia/Ho_Chi_Minh nếu bỏ trống).
# ECONOMY_TIME_ZONE=Asia/Ho_Chi_Minh

# ----------------------------------------------------------------------------
# 4. Sao lưu database
# ----------------------------------------------------------------------------
# Khoảng cách giữa các bản sao lưu (phút, 1–10080). Ưu tiên hơn DB_BACKUP_INTERVAL_HOURS.
# DB_BACKUP_INTERVAL_MINUTES=15
# Cách cũ tính theo giờ (1–168), mặc định 24 giờ.
# DB_BACKUP_INTERVAL_HOURS=24
# Số bản sao lưu giữ lại (2–90, mặc định 14). Là số bản, không phải số ngày.
# DB_BACKUP_RETENTION=14
# Thư mục lưu sao lưu. Mặc định `backups` cạnh file database.
# DB_BACKUP_DIR=
# Sao lưu khi khởi động: dời sau N giây (0–3600, mặc định 120; 0 = sao lưu ngay) để bot phục vụ trước,
# và bỏ qua nếu bản sao lưu mới nhất còn mới hơn N phút (0–10080, mặc định 30; 0 = luôn sao lưu).
# DB_BACKUP_STARTUP_DELAY_SECONDS=120
# DB_BACKUP_STARTUP_SKIP_MINUTES=30
# ID người dùng Discord nhận file sao lưu qua DM (17–20 chữ số); bỏ trống để dùng giá trị trong
# src/discordBackupConfig.json. Timeout gửi DM tính bằng giây (5–600, mặc định 60).
# DB_BACKUP_DISCORD_USER_ID=
# DB_BACKUP_DISCORD_TIMEOUT_SECONDS=60

# ----------------------------------------------------------------------------
# 5. Dọn dữ liệu cũ (số ngày giữ lại)
# ----------------------------------------------------------------------------
# Nhật ký giao dịch xu (1–365, mặc định 30).
# ECONOMY_LOG_RETENTION_DAYS=30
# Bản ghi ván game (1–365, mặc định 7).
# GAME_RECORD_RETENTION_DAYS=7
# Ván nhiều người chơi (1–90, mặc định 7).
# MULTIPLAYER_ROUND_RETENTION_DAYS=7
# Lịch sử gacha và nhật ký kim cương (mặc định 180).
# GACHA_HISTORY_RETENTION_DAYS=180
# DIAMOND_LOG_RETENTION_DAYS=180
# Phút không hoạt động trước khi ván một người chơi bị đóng (1–1440, mặc định 10).
# SOLO_SESSION_TTL_MINUTES=10

# ----------------------------------------------------------------------------
# 6. Cân bằng game — giá trị mặc định
# Admin chỉnh theo từng server bằng /quantri xemcauhinh (ưu tiên hơn các biến này);
# /quantri khoiphuc đưa về giá trị ở đây. Giá trị trong ngoặc là mặc định và khoảng hợp lệ.
# ----------------------------------------------------------------------------
# Xu khởi đầu của tài khoản mới (1000; 0–1.000.000).
# ECONOMY_STARTING_COINS=1000
# Lệnh /embed và tự đổi link: host dịch vụ embed từng nền tảng (đổi nếu dịch vụ ngừng hoạt động).
# Facebook mặc định facebed.com, Instagram ddinstagram.com, TikTok vxtiktok.com; Douyin chưa có mặc định (không đặt thì bỏ qua Douyin).
# FACEBOOK_EMBED_HOST=facebed.com
# INSTAGRAM_EMBED_HOST=ddinstagram.com
# TIKTOK_EMBED_HOST=vxtiktok.com
# DOUYIN_EMBED_HOST=
# Vua Tiếng Việt: xu thưởng (25), tỷ lệ câu khó (0.1), thời gian câu khó giây (60; 5–3600), lượt bỏ qua/ngày (5; 0–5).
# VUATIENGVIET_REWARD=25
# HARD_QUESTION_CHANCE=0.1
# HARD_QUESTION_DURATION_SECONDS=60
# VTV_DAILY_SKIP_LIMIT=5
# Poker: ante (50; 10–100.000).
# POKER_ANTE=50
# EXP và cấp: EXP mỗi cấp (200), EXP cơ bản mỗi ván (10), mốc xu đổi EXP thắng (2000), EXP tối đa mỗi ván (500).
# LEVEL_XP_PER_LEVEL=200
# GAME_EXP_BASE=10
# GAME_EXP_WIN_COIN_DIVISOR=2000
# GAME_EXP_MAX=500
# Rơi xu sau ván: tỷ lệ (0.1) và khoảng xu (100–500).
# GAME_COIN_DROP_CHANCE=0.1
# GAME_COIN_DROP_MIN=100
# GAME_COIN_DROP_MAX=500
# Trọng số gacha các bậc (tự chuẩn hóa về 100%): XU 50, R 22, SR 14, SSR 10, UR 4.
# GACHA_RATE_XU=50
# GACHA_RATE_R=22
# GACHA_RATE_SR=14
# GACHA_RATE_SSR=10
# GACHA_RATE_UR=4

# ----------------------------------------------------------------------------
# 7. Sinh tồn (Hardcore)
# ----------------------------------------------------------------------------
# Khóa bí mật để sinh thử thách Tháp hằng tuần (bắt buộc nếu dùng Tháp; giữ bí mật, không đổi giữa chừng
# vì seed thử thách phụ thuộc vào khóa này).
# TOWER_GENERATOR_SECRET=
# Đặt `legacy` để chạy engine Sinh tồn cũ. Bỏ trống = engine hiện tại (khuyến nghị).
# Số ngày giữ replay Sinh tồn đã kết thúc (14; 1–3650). Replay cũ hơn bị xóa để database không phình to.
# HARDCORE_REPLAY_RETENTION_DAYS=14
# HARDCORE_GAMEPLAY_VERSION=
# Danh sách boss cho run mới: 1 hoặc 2. Run V3 mới mặc định dùng 2; không đổi run đang tồn tại.
# HARDCORE_BOSS_ROSTER_VERSION=

# ----------------------------------------------------------------------------
# 8. Công cụ nội bộ (không cần cho bot chạy)
# ----------------------------------------------------------------------------
# Ngưỡng RTP tối đa (%) khiến `npm run simulate:rtp` báo lỗi. Mặc định 100.5.
# RTP_MAX_PERCENT=100.5
# Các biến HARDCORE_SIM_* chỉ dùng cho script mô phỏng Sinh tồn (scripts/simulate-hardcore.js và
# scripts/hardcore-*.js); xem đầu mỗi script để biết ý nghĩa.
